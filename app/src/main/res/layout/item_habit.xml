<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habitItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:elevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <View
        android:id="@+id/colorBar"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="#4B5C78" />

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHabitName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Название привычки"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1F2532" />

            </LinearLayout>

            <TextView
                android:id="@+id/btnComplete"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/chip_unselected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Выполнить"
                android:textColor="#4B5C78"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvHabitSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Пн, Ср, Пт в 08:00"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHabitProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/30 дней"
                android:textSize="12sp"
                android:textColor="#4B5C78" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 0 дней"
                android:textSize="12sp"
                android:textColor="#FF8C42" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/calendarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8F9FA"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>