<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Цветная полоска сверху -->
    <View
        android:id="@+id/colorBarTop"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#4B5C78" />

    <!-- Верхняя панель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="60dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back_circle"
            android:background="@drawable/circle_background"
            android:contentDescription="Назад" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_delete"
            android:background="@drawable/circle_background"
            android:contentDescription="Удалить"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Готово"
            android:textSize="17sp"
            android:textColor="#4B5C78"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="visible" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Цветной блок с названием -->
            <LinearLayout
                android:id="@+id/titleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F8F9FA"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <View
                    android:id="@+id/colorBarLeft"
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:background="#4B5C78" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:hint="Название привычки"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1F2532"
                    android:background="@null"
                    android:padding="0dp" />

            </LinearLayout>

            <!-- Выбор цвета -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Цвет привычки"
                android:textSize="14sp"
                android:textColor="#8E8E93"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/colorPickerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <View
                        android:id="@+id/color0"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/color_circle_red" />

                    <View
                        android:id="@+id/color1"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/color_circle_teal" />

                    <View
                        android:id="@+id/color2"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/color_circle_blue" />

                    <View
                        android:id="@+id/color3"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/color_circle_green" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <View
                        android:id="@+id/color4"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/color_circle_yellow" />

                    <View
                        android:id="@+id/color5"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/color_circle_purple" />

                    <View
                        android:id="@+id/color6"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/color_circle_orange" />

                    <View
                        android:id="@+id/color7"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/color_circle_mint" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка расписания -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F8F9FA"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Расписание"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1F2532"
                    android:layout_marginBottom="16dp" />

                <!-- Дни недели -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Дни недели"
                    android:textSize="14sp"
                    android:textColor="#8E8E93"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/weekDaysContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="8dp" />

                <!-- Время -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/tvReminder"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Время напоминания"
                        android:textSize="14sp"
                        android:textColor="#1F2532" />

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Не указано"
                        android:textSize="14sp"
                        android:textColor="#8E8E93" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="#8E8E93" />

                </LinearLayout>

            </LinearLayout>

            <!-- Карточка цели -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F8F9FA"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Цель"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1F2532"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Цель привычки"
                        android:textSize="14sp"
                        android:textColor="#1F2532" />

                    <TextView
                        android:id="@+id/tvTargetDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Бесконечная"
                        android:textSize="14sp"
                        android:textColor="#4B5C78" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="#8E8E93" />

                </LinearLayout>

            </LinearLayout>

            <!-- Описание -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Описание"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1F2532"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Что вы хотите сделать привычкой?"
                android:textSize="14sp"
                android:textColor="#1F2532"
                android:background="@drawable/edit_text_background"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:padding="16dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>