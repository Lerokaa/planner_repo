<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF"
    android:gravity="center">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Управление задачами"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1F2532"
        android:layout_marginBottom="32dp" />

    <!-- Изображение -->
    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_tasks_illustration"
        android:layout_marginBottom="32dp" />

    <!-- Подзаголовок -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Организуйте свои задачи"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F2532"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Описание -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Превратите хаос идей в четкий план действий с напоминаниями и приоритетами"
        android:textSize="16sp"
        android:textColor="#4B5C78"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <!-- Индикаторы (точки) -->
    <LinearLayout
        android:id="@+id/llIndicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">
        <!-- Точки будут обновляться программно -->
    </LinearLayout>

    <!-- Кнопки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="Назад"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#4B5C78"
            android:backgroundTint="#ADB9CC"
            android:elevation="4dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Дальше"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4B5C78"
            android:elevation="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Пропустить"
        android:textSize="16sp"
        android:textColor="#7A8CAB"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>