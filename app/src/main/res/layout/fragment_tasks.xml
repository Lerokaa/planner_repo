<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Вертикальный контейнер для фрагмента и меню -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Сюда вставится TasksFragment -->

        <!-- Нижнее меню -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu"
            app:itemIconTint="#1F2532"
            app:itemTextColor="#1F2532"
            app:itemTextAppearanceActive="@style/BottomNavText"
            app:itemTextAppearanceInactive="@style/BottomNavText" />
    </LinearLayout>

    <!-- Кнопка "+" -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="80dp"
        android:backgroundTint="#4B5C78"
        android:scaleType="center"
        app:tint="#CCD2DE"
        app:srcCompat="@drawable/ic_add"
        app:fabSize="normal"
        app:elevation="6dp"
        app:shapeAppearanceOverlay="@style/CircularFloatingActionButton" />

    <!-- Затемнение -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <!-- Модалка -->
    <LinearLayout
        android:id="@+id/modalPopup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="140dp"
        android:orientation="vertical"
        android:background="@drawable/modal_background"
        android:elevation="8dp"
        android:padding="12dp"
        android:visibility="gone">
        <TextView android:id="@+id/btnAddTask" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="Добавить задачу" android:textColor="#1F2532" android:textSize="15sp" />
        <TextView android:id="@+id/btnAddNote" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="Добавить заметку" android:textColor="#1F2532" android:textSize="15sp" />
        <TextView android:id="@+id/btnAddHabit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="Добавить привычку" android:textColor="#1F2532" android:textSize="15sp" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>