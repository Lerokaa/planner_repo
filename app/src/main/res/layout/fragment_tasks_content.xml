<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Заголовок -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ваши задачи"
            android:textColor="#1F2532"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Поиск -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/search_background"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_search" app:tint="#8E8E93" />
            <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp" android:hint="Поиск..." android:background="@null" android:textSize="16sp" android:textColor="#1F2532" android:textColorHint="#8E8E93" />
            <ImageView android:id="@+id/btnClearSearch" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_close" android:visibility="gone" app:tint="#8E8E93" />
        </LinearLayout>
    </LinearLayout>

    <!-- Фильтры -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/filterChips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/chipAll" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Все" android:textSize="14sp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginEnd="8dp" android:background="@drawable/chip_selected" android:textColor="@android:color/white" />
            <TextView android:id="@+id/chipToday" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Сегодня" android:textSize="14sp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginEnd="8dp" android:background="@drawable/chip_unselected" android:textColor="#4B5C78" />
            <TextView android:id="@+id/chipTomorrow" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Завтра" android:textSize="14sp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginEnd="8dp" android:background="@drawable/chip_unselected" android:textColor="#4B5C78" />
            <TextView android:id="@+id/chipWeek" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Эта неделя" android:textSize="14sp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginEnd="8dp" android:background="@drawable/chip_unselected" android:textColor="#4B5C78" />
            <TextView android:id="@+id/chipCompleted" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Выполненные" android:textSize="14sp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginEnd="8dp" android:background="@drawable/chip_unselected" android:textColor="#4B5C78" />
            <TextView android:id="@+id/chipUncompleted" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Активные" android:textSize="14sp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/chip_unselected" android:textColor="#4B5C78" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Заголовок списка -->
    <TextView android:id="@+id/tvSectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="По текущей дате" android:textSize="16sp" android:textStyle="bold" android:textColor="#4B5C78" android:paddingStart="20dp" android:paddingTop="16dp" android:paddingBottom="12dp" />

    <!-- Список задач -->
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:id="@+id/tasksContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="80dp" />
    </ScrollView>

</LinearLayout>